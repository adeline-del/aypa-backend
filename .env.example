# Environment Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aypa_db

# Mock Store Toggle (Set to false for production database persistence)
USE_IN_MEMORY_MOCK=false

# CORS Allowed Origin
CLIENT_URL=https://aypa-frontend.vercel.app
FRONTEND_URL=https://aypa-frontend.vercel.app

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Nodemailer SMTP Email Transport Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@aypa-accra.org
SMTP_PASS=your_smtp_password_here
SMTP_FROM=AYPA Accra Diocese <no-reply@aypa-accra.org>

# Cloudinary Binary Asset Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
